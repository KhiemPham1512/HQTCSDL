# Nếu bạn đăng nhập SSMS bằng Windows Authentication (không cần mật khẩu), để USE_WINDOWS_AUTH=true
USE_WINDOWS_AUTH=true

# Điền đúng tên Server Name trong SSMS của bạn (ví dụ: localhost hoặc localhost\SQLEXPRESS)
DB_SERVER=localhost
DB_NAME=SmartHeritageDB

# Chỉ dùng nếu bạn đặt USE_WINDOWS_AUTH=false (đăng nhập bằng tài khoản sa)
DB_USER=sa
DB_PASSWORD=your_password_here